SQUASH_BASE_URL=https://saas-inseec01.henix.com/squash
SQUASH_USERNAME=
SQUASH_PASSWORD=
SQUASH_TOKEN=
SQUASH_DOMAIN_NAME=Domaine 1 - Newform - Formulaire

# Modes possibles : latest, name, id
SQUASH_LOT_MODE=latest
SQUASH_LOT_NAME=
SQUASH_LOT_ID=

# Environnement cible : Recette ou Preprod
SQUASH_ENVIRONMENT=Recette

# Statuts Squash a recuperer
SQUASH_EXECUTION_STATUS_FILTER=A executer,Bloque,Echec

# Option locale pour valider le processus sans lancer les tests reels
QA_PROCESS_DRY_RUN=0

# Session Squash Playwright
SQUASH_SESSION_HEADLESS=0
SQUASH_SESSION_INTERACTIVE=1
SQUASH_SESSION_DEBUG=0

# Paiement de test, uniquement dans .env local
PAYMENT_TEST_CARD=
PAYMENT_TEST_EXP=
PAYMENT_TEST_CVV=
PAYMENT_TEST_BRAND=
